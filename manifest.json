{
  "manifest_version": 3,
  "name": "Cinematic Tab Recorder",
  "description": "Record current tab with polished cursor and cinematic zoom-to-click effects.",
  "version": "0.1.1",
  "permissions": [
    "activeTab",
    "tabCapture",
    "alarms",
    "offscreen",
    "storage",
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cinematic Recorder",
    "default_popup": "src/ui/popup/popup.html"
  },
  "options_page": "src/ui/options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/controller.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
